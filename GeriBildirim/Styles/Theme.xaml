<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== RENKLER ===== -->
    <Color x:Key="AnaRenk">#1F2D9A</Color>
    <Color x:Key="AnaRenkKoyu">#172275</Color>
    <Color x:Key="ArkaPlan">#F3F4F8</Color>
    <Color x:Key="Yuzey">#FFFFFF</Color>
    <Color x:Key="Kenar">#CDD1DE</Color>
    <Color x:Key="Metin">#1F2330</Color>
    <Color x:Key="MetinSoluk">#5F6577</Color>
    <Color x:Key="Tehlike">#B3261E</Color>
    <Color x:Key="TehlikeKoyu">#8C1D18</Color>

    <SolidColorBrush x:Key="AnaRenkBrush" Color="{StaticResource AnaRenk}" />
    <SolidColorBrush x:Key="AnaRenkKoyuBrush" Color="{StaticResource AnaRenkKoyu}" />
    <SolidColorBrush x:Key="ArkaPlanBrush" Color="{StaticResource ArkaPlan}" />
    <SolidColorBrush x:Key="YuzeyBrush" Color="{StaticResource Yuzey}" />
    <SolidColorBrush x:Key="KenarBrush" Color="{StaticResource Kenar}" />
    <SolidColorBrush x:Key="MetinBrush" Color="{StaticResource Metin}" />
    <SolidColorBrush x:Key="MetinSolukBrush" Color="{StaticResource MetinSoluk}" />
    <SolidColorBrush x:Key="TehlikeBrush" Color="{StaticResource Tehlike}" />
    <SolidColorBrush x:Key="TehlikeKoyuBrush" Color="{StaticResource TehlikeKoyu}" />

    <SolidColorBrush x:Key="SatirSeritBrush" Color="#F7F8FC" />
    <SolidColorBrush x:Key="SatirUzerindeBrush" Color="#ECEEF9" />
    <SolidColorBrush x:Key="SatirSeciliBrush" Color="#D9DEF4" />
    <SolidColorBrush x:Key="IzgaraBrush" Color="#E4E6EE" />
    <SolidColorBrush x:Key="DurumCubuguBrush" Color="#E9EBF3" />
    <SolidColorBrush x:Key="BasariZeminBrush" Color="#E7F4EC" />
    <SolidColorBrush x:Key="BasariMetinBrush" Color="#1B6B3A" />
    <SolidColorBrush x:Key="HataZeminBrush" Color="#FBEAE9" />
    <SolidColorBrush x:Key="HataMetinBrush" Color="#8C1D18" />

    <!-- ===== PENCERE VE METİN ===== -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource ArkaPlanBrush}" />
        <Setter Property="Foreground" Value="{StaticResource MetinBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Form alanı etiketi -->
    <Style x:Key="Etiket" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MetinSolukBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== BUTONLAR ===== -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource YuzeyBrush}" />
        <Setter Property="Foreground" Value="{StaticResource MetinBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KenarBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinWidth" Value="84" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="zemin"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" />
                        <Border x:Name="katman" Background="#14000000" CornerRadius="2" Visibility="Collapsed" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="katman" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="katman" Property="Background" Value="#28000000" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="zemin" Property="BorderBrush" Value="{StaticResource AnaRenkBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AnaButon" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AnaRenkBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource AnaRenkKoyuBrush}" />
    </Style>

    <Style x:Key="TehlikeButon" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource TehlikeBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource TehlikeKoyuBrush}" />
    </Style>

    <!-- ===== GİRİŞ KONTROLLERİ ===== -->
    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{StaticResource KenarBrush}" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="TakvimStili" TargetType="Calendar">
        <Setter Property="LayoutTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1.35" ScaleY="1.35" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CalendarStyle" Value="{StaticResource TakvimStili}" />
    </Style>

    <!-- ===== SEKMELER ===== -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Background="{StaticResource YuzeyBrush}"
                                BorderBrush="{StaticResource KenarBrush}"
                                BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" Margin="12,0,0,0" />
                        </Border>
                        <ContentPresenter Grid.Row="1"
                                          x:Name="PART_SelectedContentHost"
                                          ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource MetinSolukBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="serit"
                            Padding="18,10"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,3"
                            Cursor="Hand">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource MetinBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="serit" Property="BorderBrush" Value="{StaticResource AnaRenkBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AnaRenkBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== DATAGRID ===== -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource YuzeyBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KenarBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource IzgaraBrush}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowBackground" Value="{StaticResource YuzeyBrush}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource SatirSeritBrush}" />
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="MinRowHeight" Value="30" />
        <Setter Property="ColumnHeaderHeight" Value="34" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource AnaRenkBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{StaticResource AnaRenkKoyuBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Foreground" Value="{StaticResource MetinBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SatirUzerindeBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SatirSeciliBrush}" />
                <Setter Property="Foreground" Value="{StaticResource MetinBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True" />
                    <Condition Property="Selector.IsSelectionActive" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource SatirSeciliBrush}" />
                <Setter Property="Foreground" Value="{StaticResource MetinBrush}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== DURUM ÇUBUĞU ===== -->
    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{StaticResource DurumCubuguBrush}" />
        <Setter Property="Foreground" Value="{StaticResource MetinSolukBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KenarBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="12" />
    </Style>

</ResourceDictionary>
<Window x:Class="GeriBildirim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GeriBildirim.Views"
        Style="{StaticResource {x:Type Window}}"
        Title="Geri Bildirim"
        Width="1180" Height="720"
        MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ÜST ŞERİT -->
        <Border Grid.Row="0" Background="{StaticResource AnaRenkBrush}" Padding="18,10">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Geri Bildirim"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="White" />
                    <TextBlock Text="T.C. Ulaştırma ve Altyapı Bakanlığı — Ankara Bölge Müdürlüğü"
                               FontSize="11.5"
                               Foreground="#C9CEF0" />
                </StackPanel>

                <TextBlock x:Name="KullaniciText"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="White" />
            </Grid>
        </Border>

        <!-- SEKMELER -->
        <TabControl x:Name="Sekmeler" Grid.Row="1">
            <TabItem Header="Yeni Bildirim">
                <views:GonderView />
            </TabItem>
            <TabItem Header="Bildirimler">
                <views:YonetimView />
            </TabItem>
        </TabControl>
    </Grid>
</Window>